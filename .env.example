# Copyright (c) 2026 Luis Manuel Cousido Hermida. All rights reserved.
# Copy to .env and adjust. Every HYDRA setting uses the HYDRA_ prefix.

# Protect the gateway (strongly recommended outside localhost).
HYDRA_API_KEY=change-me

# Run without any model runtime (deterministic offline models).
HYDRA_OFFLINE=false

# Infrastructure (empty = in-memory).
HYDRA_POSTGRES_URL=
HYDRA_REDIS_URL=

# Runtimes
HYDRA_OLLAMA_BASE_URL=http://localhost:11434
HYDRA_VLLM_BASE_URL=http://localhost:8000/v1
HYDRA_VLLM_REASONER_URL=http://localhost:8000/v1
HYDRA_VLLM_CODER_URL=http://localhost:8001/v1
HYDRA_VLLM_VISION_URL=http://localhost:8002/v1
HYDRA_LLAMACPP_BASE_URL=http://localhost:8081/v1

# Optional cloud escalation (disabled when empty; PRIVATE mode never uses it).
HYDRA_CLOUD_BASE_URL=https://api.openai.com/v1
HYDRA_CLOUD_API_KEY=

# Model catalogue (config/models.ollama.yaml = local Ollama workstation).
HYDRA_MODELS_CONFIG=config/models.yaml
# Policy Kernel rules.
HYDRA_POLICY_CONFIG=config/policy.yaml
# Local state: failure memory, HYDRA Lab experiments, Model Factory store.
HYDRA_DATA_DIR=data

# Optional System-One routing classifier (a model id from the models config).
HYDRA_ROUTER_MODEL=
# Embeddings: hashing (no model) | ollama | vllm
HYDRA_EMBEDDING_PROVIDER=hashing
HYDRA_EMBEDDING_MODEL=
# e.g. HYDRA_EMBEDDING_PROVIDER=ollama HYDRA_EMBEDDING_MODEL=nomic-embed-text

# Local GPUs load models cold: stretch time budgets (2-4 recommended for Ollama on 8-16 GB VRAM).
HYDRA_BUDGET_TIME_SCALE=1
# Load-aware routing from vLLM/llama.cpp /metrics, Ollama /api/ps and nvidia-smi.
HYDRA_RUNTIME_MONITOR=true
# NATS JetStream bus (takes precedence over Redis): nats://localhost:4222
HYDRA_NATS_URL=
# Model Factory: llama.cpp checkout/build with convert_hf_to_gguf.py, llama-quantize, llama-imatrix...
HYDRA_LLAMACPP_DIR=

# Sandbox: docker (isolated container) | subprocess (development only, not a security boundary)
HYDRA_SANDBOX_BACKEND=docker
HYDRA_SANDBOX_IMAGE=python:3.12-slim

# Domains research workers may fetch from (comma separated).
HYDRA_NETWORK_DOMAINS=wikipedia.org,arxiv.org,github.com,python.org

POSTGRES_PASSWORD=hydra
HF_TOKEN=

# ---- HYDRA 1.0 planes -------------------------------------------------------------
# Capture pipeline (World Model, content-addressed artifacts, corpus, signed ledger, flight recorder).
HYDRA_CAPTURE=true
# Own executions at or below this sensitivity are trainable by default (0=PUBLIC, 1=INTERNAL).
HYDRA_CORPUS_AUTO_TRAINING_MAX_SENSITIVITY=0
# Deterministic-first: calculator / sympy / JSON / SQL solvers answer without models when certain.
HYDRA_DETERMINISTIC_FIRST=false
# Policy DSL and license profiles.
HYDRA_POLICY_RULES_CONFIG=config/policy_rules.yaml
HYDRA_LICENSES_CONFIG=config/licenses.yaml
# Cluster: node id (default hostname), placement re-ranking and heartbeat period.
HYDRA_NODE_ID=
HYDRA_CLUSTER_RERANK=true
HYDRA_HEARTBEAT_INTERVAL_S=15
# OpenTelemetry OTLP/HTTP endpoint (GenAI semantic conventions), e.g. http://localhost:4318
HYDRA_OTEL_ENDPOINT=
# AutoBuilder llama-server binary (hydra build --auto --runtime llama.cpp).
HYDRA_LLAMA_SERVER=
# Secrets Broker: tools receive secret://group/name references resolved at execution time, e.g.
# HYDRA_SECRET_GITHUB_TOKEN=ghp_...   (models never see the value)
