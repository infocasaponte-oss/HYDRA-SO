{
  "version": "hydra-base-categories-v1",
  "date": "2026-10-04",
  "purpose": "Ten data categories for the next HYDRA Base stage (target ~6B valid tokens, 350M-1B parameters). Targets are valid tokens after the corpus filters; the downloader keeps ~1.4x the gap in raw characters because filtering discards part of it. Priority = largest relative gap first.",
  "chars_per_token": 3.9,
  "categories": [
    {
      "id": "codigo",
      "name": "Código (Python, JS, Java, C/C++, Go, Rust, SQL, shell)",
      "target_tokens": 1000000000,
      "current_tokens": 16000000,
      "sources": [
        "stackv2_code"
      ]
    },
    {
      "id": "lingua_moderna",
      "name": "Lingua moderna xeral (castelán + inglés)",
      "target_tokens": 2000000000,
      "current_tokens": 0,
      "sources": [
        "eurlex_es",
        "bsc_legal_paragraphs_es",
        "dgt_es",
        "boa_aragon",
        "youtube_commons_es",
        "youtube_en",
        "news_en",
        "common_corpus_mixed"
      ],
      "language_targets": {
        "es": 1000000000,
        "en": 1000000000
      },
      "note": "Spanish: EUR-Lex proposals and international agreements (formal register). English: YouTube Commons transcripts (CC BY, spoken), CC BY news, US government sites. Gap: further modern Spanish (Eurovoc, VoxPopuli) is spread thinly across Common Corpus (~0.15M tokens per 470 MB file) and is not downloadable efficiently."
    },
    {
      "id": "ciencia",
      "name": "Ciencia e investigación",
      "target_tokens": 800000000,
      "current_tokens": 0,
      "sources": [
        "openstax_es",
        "arxiv_papers",
        "pubmed",
        "pes2o",
        "common_corpus_mixed"
      ]
    },
    {
      "id": "industria",
      "name": "Robótica, drones, impresión 3D e automatización",
      "target_tokens": 500000000,
      "current_tokens": 0,
      "sources": [
        "uspto_industry"
      ]
    },
    {
      "id": "educacion",
      "name": "Educación e manuais",
      "target_tokens": 500000000,
      "current_tokens": 0,
      "sources": [
        "libretexts_cc_by",
        "doab_books",
        "pressbooks",
        "oercommons",
        "cosmopedia_openstax"
      ]
    },
    {
      "id": "matematicas",
      "name": "Matemáticas e razoamento",
      "target_tokens": 300000000,
      "current_tokens": 0,
      "sources": [
        "openstax_es"
      ],
      "note": "filled by routing math/stats LibreTexts books from the educacion source"
    },
    {
      "id": "documentacion_tecnica",
      "name": "Documentación técnica",
      "target_tokens": 400000000,
      "current_tokens": 42000000,
      "sources": [
        "stackv2_markdown"
      ]
    },
    {
      "id": "lexislacion",
      "name": "Lexislación e administración",
      "target_tokens": 600000000,
      "current_tokens": 156000000,
      "sources": [
        "eurlex_es",
        "regulations_us",
        "common_corpus_mixed",
        "boa_aragon"
      ]
    },
    {
      "id": "prensa",
      "name": "Prensa e actualidade",
      "target_tokens": 300000000,
      "current_tokens": 146000000,
      "sources": [],
      "gap": "modern Spanish news under an admitted licence not found; current data is public-domain 19th-20th c."
    },
    {
      "id": "literatura",
      "name": "Literatura e historia",
      "target_tokens": 600000000,
      "current_tokens": 497000000,
      "sources": [],
      "note": "close to target with PleIAs public-domain books; nothing downloaded"
    }
  ],
